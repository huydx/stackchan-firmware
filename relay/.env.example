# Bind to the LAN for the bot. Use a trusted network: device audio is plain ws.
HOST=0.0.0.0
PORT=8080
# Generate: openssl rand -hex 32. Match BOT_RELAY_TOKEN in bot_config.h.
DEVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
REALTIME_PROVIDER=openai
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
LIVE_BACKEND_MODEL=gpt-4.1-mini
REALTIME_VOICE=marin
# For Azure GA: set REALTIME_PROVIDER=azure and fill these in.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-1.5
AZURE_OPENAI_API_KEY=
BOT_INSTRUCTIONS=You are StackChan, a friendly small robot. Reply briefly in Japanese unless asked for another language. Show your mood through your face when appropriate. Your voice is AI generated. You cannot move your body or control physical devices.
